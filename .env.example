# ==============================================================================
# VisionAI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set variables in your environment.
# Never commit real API keys or sensitive production credentials to version control.

# Application Environment (development | staging | production)
ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Model & Detection Settings
MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
MAX_FILE_SIZE_MB=15

# Compute Target: "cpu" or "cuda" (auto-detected if omitted)
DEVICE=cpu

# Optional Analytics / Tracking
ENABLE_ANALYTICS=true
